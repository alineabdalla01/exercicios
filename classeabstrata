// Classe abstrata Animal
abstract class Animal {
    protected String nome; // Nome do animal de estimação

    // Construtor
    public Animal(String nome) {
        this.nome = nome;
    }

    // Método abstrato que cada animal deve implementar
    public abstract void emitirSom();

    // Getter do nome
    public String getNome() {
        return nome;
    }
}

// Classe concreta: Cachorro
class Cachorro extends Animal {

    public Cachorro(String nome) {
        super(nome);
    }

    @Override
    public void emitirSom() {
        System.out.println(nome + " diz: au au au au");
    }
}

// Classe principal para testar
public class Classeabstrata {
    public static void main(String[] args) {
        // Criando um animal de estimação
        Cachorro meuCachorro = new Cachorro("Scooby");

        // Mostrando o nome e emitindo som
        System.out.println("Nome do animal: " + meuCachorro.getNome());
        meuCachorro.emitirSom();
    }
}
